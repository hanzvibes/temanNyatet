# Supabase — required for subscription and webhook endpoints
# Copy from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# Mayar payment webhook — required for /api/mayar-webhook
# Copy from: Mayar Dashboard → Integrations → Webhook secret
MAYAR_WEBHOOK_SECRET=your-mayar-webhook-secret

# Cron job — required for /api/cron/archive-expired
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# Google Sheets — required for notes/transactions/todos/links data endpoints
# (auth stays on Supabase; only app data lives in the sheet)
# GOOGLE_SERVICE_ACCOUNT_KEY: paste the full JSON key file content for a
#   Google Cloud service account with the Sheets API enabled.
# GOOGLE_SHEETS_SPREADSHEET_ID: the ID from the sheet's URL
#   (.../d/<THIS_PART>/edit). Share the sheet with the service account's
#   email (found in the JSON key as client_email) with Editor access.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id

# Server config (optional — defaults shown)
PORT=8080
LOG_LEVEL=info
