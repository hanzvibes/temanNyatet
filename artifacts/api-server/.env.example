# Supabase — required for subscription, webhook, profile, and auth endpoints
# Copy from: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# Google OAuth — required for notes/transactions/todos/links data endpoints
# Create in Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Google OAuth state signing — required for CSRF protection on /api/auth/google/callback
# Generate a random secret: openssl rand -hex 32
GOOGLE_OAUTH_STATE_SECRET=your-random-hex-secret

# Legacy Mayar webhook compatibility (only needed while old callers remain)
MAYAR_WEBHOOK_SECRET=your-legacy-mayar-webhook-secret

# Cron job — required for /api/cron/archive-expired
# Generate a random secret: openssl rand -hex 32
CRON_SECRET=your-random-cron-secret

# Optional: site URL used for server-side redirects and auth emails.
# If omitted, the server falls back to the request origin / FRONTEND_URL.
# SITE_URL=https://temannyatet.id

# Optional: frontend URL used for OAuth callback redirects.
# If omitted, falls back to REPLIT_DEV_DOMAIN or http://localhost:5000
# FRONTEND_URL=https://your-frontend-domain.com

# Optional: OAuth redirect URI override.
# If omitted, falls back to https://<REPLIT_DEV_DOMAIN>/api/auth/google/callback
# or http://localhost:5000/api/auth/google/callback
#
# Current production (Vercel):
#   https://teman-nyatet-api-server.vercel.app/api/auth/google/callback
#
# Must match Google Cloud Console Authorized redirect URIs byte-for-byte
# (case-sensitive, no trailing slash). See docs/GOOGLE-CLOUD-OAUTH.md
# for the full checklist.
# GOOGLE_REDIRECT_URI=https://teman-nyatet-api-server.vercel.app/api/auth/google/callback

# Optional: comma-separated CORS allowlist. If omitted, all origins are allowed.
# ALLOWED_ORIGINS=https://your-frontend-domain.com

# Server config (optional — defaults shown)
PORT=8080
LOG_LEVEL=info

# SumoPod Payment Sandbox — server-only, never use a VITE_ prefix
SUMOPOD_PAYMENT_API_KEY=your-regenerated-sandbox-api-key
SUMOPOD_PAYMENT_BASE_URL=https://api-pay-sandbox.sumopod.com
# Set only if SumoPod exposes/configures webhook signing for your project
SUMOPOD_WEBHOOK_SECRET=
