# Supabase — required for auth only (notes/transactions/todos/links live in
# Google Sheets via the api-server, see artifacts/api-server/.env.example)
# Copy from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key

# API server — only needed if the frontend and api-server are deployed to
# different origins (e.g. frontend on Vercel, api-server elsewhere).
# Leave unset in Replit dev; the Vite dev server proxies /api to localhost:8080.
# VITE_API_SERVER_URL=https://your-api-server.example.com
